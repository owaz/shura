PORT=5001
NODE_ENV=production

# Database Configuration (Production)
# Prefer DATABASE_URL when the production database provider supplies one.
# Otherwise leave it blank and populate every DB_* value below.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_USER=postgres
DB_HOST=your-production-db-host
DB_NAME=shura
DB_PASSWORD=your-production-db-password
DB_PORT=5432
DB_SSL=true

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.shura.com
AUTH0_CLAIM_NAMESPACE=https://shura.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# M2M permissions used by current account/admin flows: read:users,
# update:users, delete:users, create:user_tickets, read:roles,
# and create:role_members.
AUTH0_ROLE_THERAPIST_ID=

# Legacy JWT Secret (deprecated)
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_STRING_FOR_PRODUCTION
CALENDAR_TOKEN_SECRET=CHANGE_THIS_TO_A_SEPARATE_32_BYTE_OR_LONGER_SECRET

# Azure Blob Storage (private image container)
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_IMAGE_CONTAINER=shura-images
AZURE_STORAGE_SAS_TTL_MINUTES=15
# Optional for a user-assigned Managed Identity; omit for system-assigned.
AZURE_CLIENT_ID=

# Email Configuration (Gmail)
EMAIL_USER=shuraa.life@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
ADMIN_EMAIL=shuraa.life@gmail.com

# Public application origins
FRONTEND_URL=https://app.example.com
FRONTEND_URLS=https://app.example.com
BACKEND_URL=https://app.example.com

# Razorpay Configuration (Production)
# Apply for live keys AFTER deployment at https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_your_production_key
RAZORPAY_KEY_SECRET=your_production_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Calendar provider applications (optional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://app.example.com/api/calendar/google/callback
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=https://app.example.com/api/calendar/outlook/callback

# Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...;ApplicationId=...

# Cookie/session configuration
# The selected single-container deployment is same-origin.
COOKIE_SAME_SITE=lax
