PORT=5001
NODE_ENV=development

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=shura
DB_PASSWORD=your_database_password
DB_PORT=5432

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.shura.local
AUTH0_CLAIM_NAMESPACE=https://shura.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_ROLE_THERAPIST_ID=

# Legacy JWT secret (only for deprecated local-dev flows)
JWT_SECRET=shura_super_secret_jwt_key_2024

# Cloudinary Configuration (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_FOLDER=shura/uploads

# Email Configuration (Gmail)
# Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
ADMIN_EMAIL=your-email@gmail.com

# Frontend URL(s)
FRONTEND_URL=http://localhost:3006
FRONTEND_URLS=http://localhost:3006

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Azure Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Cookie/session configuration
# Use lax for local/same-site deployments. Use none for cross-site HTTPS frontend/backend domains.
COOKIE_SAME_SITE=lax
