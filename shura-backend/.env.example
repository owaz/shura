PORT=5001
NODE_ENV=development

# Database Configuration
# Prefer DATABASE_URL when your development database provider supplies one.
# Otherwise leave it blank and populate every DB_* value below.
DATABASE_URL=
DB_USER=postgres
DB_HOST=localhost
DB_NAME=shura
DB_PASSWORD=
DB_PORT=5432
DB_SSL=false
# Local-only escape hatch. Production rejects false.
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA certificate; use literal \n separators in one-line secret stores.
DB_SSL_CA_CERT=

# Required guard for the local bootstrap and synthetic seed commands.
# Set this to true only when the configured database is safe to mutate.
E2E_DATABASE_SAFE_TO_MUTATE=false

# Auth0 subjects and emails for synthetic users in the existing development tenant.
E2E_CLIENT_AUTH0_SUB=auth0|replace-with-development-client-sub
E2E_CLIENT_EMAIL=client-e2e@example.test
E2E_THERAPIST_AUTH0_SUB=auth0|replace-with-development-therapist-sub
E2E_THERAPIST_EMAIL=therapist-e2e@example.test
E2E_ADMIN_AUTH0_SUB=auth0|replace-with-development-admin-sub
E2E_ADMIN_EMAIL=admin-e2e@example.test

# Auth0 Configuration
AUTH0_DOMAIN=your-development-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.shura.local
AUTH0_CLAIM_NAMESPACE=https://shura.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
# M2M permissions required by the client portal: update:users,
# delete:users, and create:user_tickets.
AUTH0_ROLE_THERAPIST_ID=

# Local signing secrets. Generate unique values; never reuse production secrets.
JWT_SECRET=generate-a-unique-random-secret-at-least-32-characters
CALENDAR_TOKEN_SECRET=

# Azure Blob Storage (private image container)
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_IMAGE_CONTAINER=shura-images
AZURE_STORAGE_SAS_TTL_MINUTES=15
# Local development only. Production uses the app's Managed Identity.
AZURE_STORAGE_CONNECTION_STRING=
# Optional when production uses a user-assigned Managed Identity.
AZURE_CLIENT_ID=

# Email Configuration (Resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@your-verified-domain.example
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret
ADMIN_EMAIL=admin@example.com
# Pausing the worker leaves newly queued messages pending.
EMAIL_OUTBOX_WORKER_ENABLED=true

# Frontend URL(s)
FRONTEND_URL=http://localhost:3006
FRONTEND_URLS=http://localhost:3006
BACKEND_URL=http://localhost:5001

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Calendar provider applications (optional during core portal QA)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5001/api/calendar/google/callback
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_REDIRECT_URI=http://localhost:5001/api/calendar/outlook/callback

# Azure Application Insights (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Cookie/session configuration
# Use lax for local/same-site deployments. Use none for cross-site HTTPS frontend/backend domains.
COOKIE_SAME_SITE=lax
